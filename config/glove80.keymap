/*
ZMK
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>


/* ===== Layer ===== */

#define LAYER_Base    0
#define LAYER_Nav     1
#define LAYER_Sym     2
#define LAYER_Magic   3
/* Layer 4 und 5: Reserve fuer ZMK Studio */



/ {

    /* ===== Behaviors ===== */

    behaviors {

        /* Esc/Ctrl: tippen = Esc, halten = Ctrl.
         * balanced: Ctrl+C geht sofort, ein schnelles "Esc, dann j" bleibt Esc + j.
         */
        esc_ctl: esc_ctl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            retro-tap;
            bindings = <&kp>, <&kp>;
        };

        sym_sym: sym_sym { compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_Sym>, <&tog LAYER_Sym>;
        };
        /* Bluetooth-Profile: einmal tippen = auswaehlen, zweimal tippen = Verbindung trennen */
        bt_0: bt_0 { compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };
    };

    /* ===== Combos ===== */

    combos {
        compatible = "zmk,combos";

        /* Zeige- + Mittelfinger auf der Home-Row = Sym-Layer (beide Combos, ein Layer).
         * J+K halten: links tippen.  D+F halten: rechts tippen.
         * Positionen: 37 = D, 38 = F, 41 = J, 42 = K
         */
        c_sym_r { timeout-ms = <30>; key-positions = <41 42>; bindings = <&mo LAYER_Sym>; layers = <LAYER_Base>; slow-release; };
        c_sym_l { timeout-ms = <30>; key-positions = <37 38>; bindings = <&mo LAYER_Sym>; layers = <LAYER_Base>; slow-release; };
    };

    /* ===== Macros ===== */

    macros {

        /* Ausgabe auf Bluetooth stellen (sonst gewinnt USB, wenn ein Kabel steckt)
         * und dann das Profil auswaehlen
         */
        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };
        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };
        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };
    };


    /* ===== Keymap =====
     * Pro Reihe: erst linke Hand, dann rechte Hand.
     * Reihe 5 und 6 enthalten zusaetzlich die Daumentasten (je 3 links, 3 rechts).
     * Die Reihenfolge der Layer muss zu den LAYER_*-Nummern oben passen.
     */

    keymap {
        compatible = "zmk,keymap";

        /* ----- 0: Base ----- */
        layer_Base {
            display-name = "Base";
            bindings = <
                // Reihe 1
                /* links     */ &none &none &none &none &none 
                /* rechts    */ &none &none &none &none &none 

                // Reihe 2
                /* links     */ &none        &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4 &kp NUMBER_5
                /* rechts    */ &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0 &kp F12

                // Reihe 3
                /* links     */ &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T
                /* rechts    */ &kp Y       &kp U       &kp I       &kp O       &kp P       &kp MINUS

                // Reihe 4
                /* links     */ &esc_ctl LCTRL ESC     &kp A       &kp S       &kp D       &kp F       &kp G
                /* rechts    */ &kp H                  &kp J       &kp K       &kp L       &kp SEMI    &kp RET

                // Reihe 5 + obere Daumentasten
                /* links     */ &kp LSHIFT   &kp Z      &kp X       &kp C       &kp V       &kp B
                /* Daumen L  */ &none        &none      &none
                /* Daumen R  */ &none        &none      &none 
                /* rechts    */ &kp N        &kp M      &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT

                // Reihe 6 + untere Daumentasten
                /* links     */ &mo LAYER_Magic         &none            &none                 &none  &none  
                /* Daumen L  */ &kp LGUI                &kp LALT         &mo LAYER_Nav 
                /* Daumen R  */ &kp BACKSPACE           &sym_sym         &kp SPACE 
                /* rechts    */ &none                   &none            &none                 &none  &none
            >;
        };
        
        
        /* ----- 1: Nav (linken inneren Daumen halten) -----
         * links:  Edit-Tasten fuer die Arbeit mit Maus in der rechten Hand
         * rechts: Pfeile auf HJKL wie in Vim
         * &trans = durchlaessig, die Taste vom Base-Layer gilt weiter
         */
        layer_Nav {
            display-name = "Nav";
            bindings = <
                // Reihe 1
                /* links     */ &none  &none  &none  &none  &none
                /* rechts    */ &none  &none  &none  &none  &none

                // Reihe 2
                /* links     */ &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6
                /* rechts    */ &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12

                // Reihe 3
                /* links     */ &none  &none  &none  &none  &none  &none 
                /* rechts    */ &none  &none  &none  &none  &none  &none

                // Reihe 4
                /* links     */ &trans           &none           &kp SPACE     &kp BSPC          &kp RET  &none 
                /* rechts    */ &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW   &none    &trans

                // Reihe 5 + obere Daumentasten
                /* links     */ &trans  &none  &none  &none  &none  &none
                /* Daumen L  */ &none   &none  &none
                /* Daumen R  */ &none   &none  &none
                /* rechts    */ &none   &none  &none  &none  &none  &trans 

                // Reihe 6 + untere Daumentasten
                /* links     */ &trans  &none   &none  &none  &none
                /* Daumen L  */ &trans  &trans  &none
                /* Daumen R  */ &none   &trans  &trans
                /* rechts    */ &none   &none   &none  &none  &none
            >;
        };

         /* ----- 2: Symbol layer ----- */
        layer_Sym {
            display-name = "Sym";
            bindings = <
                // Reihe 1
                /* links     */ &trans &trans &trans &trans &trans   
                /* rechts    */ &trans &trans &trans &trans &trans

                // Reihe 2
                /* links     */ &kp GRAVE &kp CARET &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp AMPERSAND &kp PERCENT
                /* rechts    */ &kp SLASH &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &trans &trans
 
                // Reihe 3
                /* links     */ &kp APOSTROPHE &kp DOUBLE_QUOTES &kp LEFT_BRACKET &kp LEFT_BRACE &kp RIGHT_BRACE &kp RIGHT_BRACKET
                /* rechts    */ &kp MINUS &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6 &trans &trans
                
                // Reihe 4
                /* links     */ &kp HASH &kp EXCL &kp EQUAL &kp UNDERSCORE &kp DOLLAR &kp QUESTION
                /* rechts    */ &kp PLUS &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &trans &trans
                
                // Reihe 5 + obere Daumentasten
                /* links     */ &kp TILDE &kp LESS_THAN &kp PIPE &none &kp GREATER_THAN &kp AT_SIGN
                /* Daumen L  */ &trans &trans &trans   
                /* Daumen R  */ &trans &trans &trans  
                /* rechts    */ &kp ASTERISK &trans &kp NUMBER_0 &trans &trans &trans

                // Reihe 6 + untere Daumentasten
                /* links     */ &trans &trans &trans &trans &trans   
                /* Daumen L  */ &trans &trans &trans   
                /* Daumen R  */ &trans &trans &trans   
                /* rechts    */ &trans &trans &trans &trans &trans
            >;
        };

        /* ----- 2: Magic (Bluetooth, RGB, Bootloader) ----- */
        layer_Magic {
            display-name = "Magic";
            bindings = <
                // Reihe 1
                /* links     */ &bt BT_CLR       &none            &none            &none            &none
                /* rechts    */ &none            &none            &none            &none            &bt BT_CLR_ALL

                // Reihe 2
                /* links     */ &none       &none            &none            &none            &none &none
                /* rechts    */ &none       &none            &none            &none            &none &none

                // Reihe 3
                /* links     */ &none            &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG
                /* rechts    */ &none            &studio_unlock   &none            &none            &none            &none
                //                               Magic + U = ZMK Studio entsperren

                // Reihe 4
                /* links     */ &none            &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF
                /* rechts    */ &none            &none            &none            &none            &none            &bootloader

                // Reihe 5 + obere Daumentasten
                /* links     */ &none            &none            &none            &none            &none            &none
                /* Daumen L  */ &bt_2            &bt_3            &none
                /* Daumen R  */ &none            &none            &none
                /* rechts    */ &none            &none            &none            &none            &none            &sys_reset

                // Reihe 6 + untere Daumentasten
                /* links     */ &none            &none            &none            &none            &none
                /* Daumen L  */ &bt_0            &bt_1            &out OUT_USB
                /* Daumen R  */ &none            &none            &none
                /* rechts    */ &none            &none            &none            &none            &none
            >;
        };


        /* ----- 4 und 5: Reserve-Layer fuer ZMK Studio -----
         * In normalen Builds ignoriert. In Studio aktivieren, umbenennen und belegen.
         */
        layer_Extra1 {
            display-name = "Extra1";
            status = "reserved";
            bindings = <
                &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans   &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans   &trans &trans &trans   &trans &trans &trans   &trans &trans &trans &trans &trans
            >;
        };

        layer_Extra2 {
            display-name = "Extra2";
            status = "reserved";
            bindings = <
                &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans   &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans   &trans &trans &trans   &trans &trans &trans   &trans &trans &trans &trans &trans
            >;
        };

    };
};
